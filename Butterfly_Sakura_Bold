<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Premium Message For You</title>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght=700&family=Poppins:wght=400;600&display=swap" rel="stylesheet">
<style>
    :root {
        --primary-glow: #ff758c;
        --secondary-glow: #ff7eb3;
    }

    body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #000;
        font-family: 'Poppins', sans-serif;
    }

    /* High-Res Cinematic Mountain Background */
    .premium-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2070&q=100') no-repeat center center;
        background-size: cover;
        z-index: -3;
        transform: scale(1.05);
        animation: breathBg 20s infinite alternate ease-in-out;
    }

    /* Soft Atmospheric Lighting Overlay */
    .melody-light {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: linear-gradient(135deg, rgba(255, 220, 150, 0.25) 0%, rgba(255, 120, 150, 0.15) 50%, rgba(0, 20, 50, 0.35) 100%);
        mix-blend-mode: overlay;
        z-index: -2;
    }

    /* Ambient Magical Particles */
    .firefly {
        position: absolute;
        width: 3px;
        height: 3px;
        background: #FFD700;
        border-radius: 50%;
        box-shadow: 0 0 8px #FFD700, 0 0 15px #FFD700;
        z-index: -1;
        animation: floatParticle 5s infinite ease-in-out alternate;
    }

    /* ====== DEEP VIBRANT SAKURA PETALS ====== */
    .sakura {
        position: absolute;
        top: -10vh;
        border-radius: 15px 2px 15px 15px; /* Perfect Petal Shape */
        opacity: 0.95; /* Increased opacity for absolute clarity */
        z-index: 1;
        pointer-events: none;
        box-shadow: 0 0 10px rgba(255, 20, 147, 0.4); /* Stronger premium pink glow */
        animation: fallAndSway linear infinite;
    }

    /* Glassmorphic Click Board */
    #board {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 30px;
        color: #FFF;
        padding: 15px 50px;
        font-size: 24px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        cursor: pointer;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3), inset 0 0 15px rgba(255,255,255,0.2);
        transition: all 0.4s ease;
        z-index: 20;
        text-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    #board:hover {
        background: rgba(255, 255, 255, 0.25);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4), inset 0 0 20px rgba(255,255,255,0.4), 0 0 20px var(--primary-glow);
        transform: translate(-50%, -50%) scale(1.05);
    }

    /* Glowing Text Message */
    #message {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.8);
        font-family: 'Dancing Script', cursive;
        font-size: 75px;
        color: #fff;
        text-shadow: 0 0 15px #ff758c, 0 0 30px #ff7eb3, 0 0 45px #ff1493;
        opacity: 0;
        transition: all 2.5s cubic-bezier(0.25, 1, 0.5, 1);
        z-index: 20;
        white-space: nowrap;
        pointer-events: none;
    }

    /* Side-Flying Butterfly System */
    .butterfly-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 15;
        pointer-events: none;
    }
    
    .butterfly {
        position: absolute;
        left: -80px;
        width: 50px;
        height: 40px;
        animation: sideCruise var(--speed) linear forwards;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bf-svg {
        width: 100%;
        height: 100%;
        transform: rotate(-15deg); 
    }

    .bf-wing-top, .bf-wing-bottom {
        transform-origin: 20px 20px;
        animation: flapVertical 0.12s infinite alternate ease-in-out;
    }

    /* Keyframe Animations */
    @keyframes breathBg {
        from { transform: scale(1); }
        to { transform: scale(1.05); }
    }

    @keyframes floatParticle {
        from { transform: translateY(0) translateX(0); opacity: 0.3; }
        to { transform: translateY(-80px) translateX(30px); opacity: 1; }
    }

    @keyframes fallAndSway {
        0% { transform: translate(0, 0) rotate(0deg); opacity: 0; }
        10% { opacity: var(--max-opacity); }
        90% { opacity: var(--max-opacity); }
        100% { transform: translate(var(--drift), 110vh) rotate(var(--rot)); opacity: 0; }
    }

    @keyframes sideCruise {
        0% { left: -80px; top: var(--startY); }
        100% { left: 105vw; top: var(--endY); }
    }

    @keyframes flapVertical {
        0% { transform: scaleY(1); }
        100% { transform: scaleY(0.15); }
    }
</style>
</head>
<body>

    <div class="premium-bg"></div>
    <div class="melody-light"></div>
    
    <div class="butterfly-container" id="butterflies"></div>
    <div id="sakura-container"></div>
    <div id="fireflies"></div>

    <button id="board">Click to Reveal</button>

    <div id="message">I Love You</div>

    <script>
        const board = document.getElementById('board');
        const message = document.getElementById('message');
        const firefliesContainer = document.getElementById('fireflies');
        const sakuraContainer = document.getElementById('sakura-container');
        const butterflyContainer = document.getElementById('butterflies');

        const butterflyGradients = [
            { start: '#ff758c', end: '#ff7eb3' },
            { start: '#ff9a44', end: '#fc6076' },
            { start: '#4facfe', end: '#00f2fe' },
            { start: '#b1f2ff', end: '#ffd1ff' }
        ];

        // 1. Generate Fireflies
        for(let i = 0; i < 35; i++) {
            let firefly = document.createElement('div');
            firefly.className = 'firefly';
            firefly.style.left = Math.random() * 100 + 'vw';
            firefly.style.bottom = Math.random() * 100 + 'vh';
            firefly.style.animationDuration = (Math.random() * 3 + 3) + 's';
            firefly.style.animationDelay = Math.random() * 2 + 's';
            firefliesContainer.appendChild(firefly);
        }

        // 2. Sakura Falling Petals (FIXED: Rich, solid, deep cherry pink gradients)
        const sakuraColors = [
            'linear-gradient(135deg, #ff1493 0%, #ff4500 100%)', // Deep Hot Pink to Orange-Red Burst
            'linear-gradient(135deg, #e6005c 0%, #ff66b2 100%)', // Rich Magenta to Solid Rose Pink
            'linear-gradient(135deg, #ff007f 0%, #b30059 100%)'  // Vibrant Neon Pink to Dark Crimson
        ];

        function createSakura() {
            const petal = document.createElement('div');
            petal.className = 'sakura';
            const size = Math.random() * 12 + 10; // Slightly larger for better visual weight
            const startLeft = Math.random() * 100; 
            const animDuration = Math.random() * 5 + 5; 
            const drift = (Math.random() * 200 - 100) + 'vw'; 
            const rotation = Math.random() * 360 + 360 + 'deg'; 
            const color = sakuraColors[Math.floor(Math.random() * sakuraColors.length)];

            petal.style.width = size + 'px';
            petal.style.height = size * 1.3 + 'px'; 
            petal.style.left = startLeft + 'vw';
            petal.style.background = color;
            petal.style.setProperty('--drift', drift);
            petal.style.setProperty('--rot', rotation);
            petal.style.setProperty('--max-opacity', Math.random() * 0.2 + 0.8); // High solid opacity (80% to 100%)
            petal.style.animationDuration = animDuration + 's';
            
            sakuraContainer.appendChild(petal);
            setTimeout(() => { petal.remove(); }, animDuration * 1000);
        }
        setInterval(createSakura, 250); // Balanced stream density

        // 3. Side Profile Cruise Butterfly Generator
        function createSideButterfly() {
            const bf = document.createElement('div');
            bf.className = 'butterfly';
            
            const startY = Math.random() * 60 + 15 + 'vh'; 
            const endY = parseFloat(startY) + (Math.random() * 15 - 7.5) + 'vh'; 
            const speed = Math.random() * 5 + 8 + 's'; 
            const colorId = Math.floor(Math.random() * butterflyGradients.length);
            const grad = butterflyGradients[colorId];

            bf.style.setProperty('--startY', startY);
            bf.style.setProperty('--endY', endY);
            bf.style.setProperty('--speed', speed);

            bf.innerHTML = `
                <svg class="bf-svg" viewBox="0 0 50 40">
                    <defs>
                        <linearGradient id="sideBfGrad-${colorId}-${parseFloat(startY)}" x1="0%" y1="100%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="${grad.start}"/>
                            <stop offset="100%" stop-color="${grad.end}"/>
                        </linearGradient>
                    </defs>
                    <g>
                        <path class="bf-wing-top" d="M20,20 C18,5 38,-2 42,8 C45,15 32,22 20,20" fill="url(#sideBfGrad-${colorId}-${parseFloat(startY)})" opacity="0.95"/>
                        <path class="bf-wing-bottom" d="M20,20 C22,32 35,38 38,32 C42,26 30,22 20,20" fill="url(#sideBfGrad-${colorId}-${parseFloat(startY)})" opacity="0.8"/>
                    </g>
                    <path d="M6,22 C12,21 18,20 24,19" stroke="#1a1a1a" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                    <path d="M24,19 Q29,15 32,16" stroke="#1a1a1a" stroke-width="1" fill="none"/>
                    <path d="M24,19 Q28,22 31,24" stroke="#1a1a1a" stroke-width="1" fill="none"/>
                </svg>
            `;

            butterflyContainer.appendChild(bf);
            setTimeout(() => { bf.remove(); }, parseFloat(speed) * 1000);
        }
        
        for(let i=0; i<3; i++) { setTimeout(createSideButterfly, i * 2500); }
        setInterval(createSideButterfly, 4500);

        // 4. Reveal Message Event
        board.addEventListener('click', () => {
            board.style.transform = 'translate(-50%, -50%) scale(1.2)';
            board.style.opacity = '0';
            setTimeout(() => { board.style.display = 'none'; }, 400);

            setTimeout(() => {
                message.style.opacity = '1';
                message.style.transform = 'translate(-50%, -50%) scale(1)';
            }, 500); 
        });
    </script>
</body>
</html>
